{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@9.10.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.10.0 --dir ../.. build:doc",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/introduction/",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "/docs/introduction/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/api/ping.json"
    }
  ],
  "headers": [
    {
      "source": "/api/ping",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/ping.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
